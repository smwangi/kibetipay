{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "loanId":          { "type": "keyword" },
      "borrowerId":      { "type": "keyword" },
      "agentId":         { "type": "keyword" },
      "principalMinor":  { "type": "long" },
      "currency":        { "type": "keyword" },
      "status":          { "type": "keyword" },
      "declineReasons":  { "type": "text" },
      "repaidMinor":     { "type": "long" },
      "repaymentCount":  { "type": "integer" },
      "repaymentIds":    { "type": "keyword", "index": false, "doc_values": false },
      "outstandingMinor":{ "type": "long" },
      "disbursedAt":     { "type": "date", "format": "epoch_millis" },
      "lastRepaymentAt": { "type": "date", "format": "epoch_millis" },
      "updatedAt":       { "type": "date", "format": "epoch_millis" }
    }
  }
}
