# Spring Boot API the web app talks to (server-side only; never exposed to the browser).
KIBETIPAY_API_URL=http://localhost:8080

# Encrypts the session cookie. Required for `npm run start` / production; generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# OpenTelemetry (src/instrumentation.ts). Unset = spans are not exported.
# Local dev: the compose otel-lgtm container (Grafana on http://localhost:3001).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Production: sample a fraction of new traces; the backend follows this service's decision.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
