# Copy to deploy/users.env (gitignored). Accounts the API accepts; one block per user, numbered from 0.
# Passwords are bcrypt hashes, never plain text. Make one with (macOS/Linux):
#   htpasswd -nbBC 12 "" 'the-password' | tr -d ':\n'
# then prefix it with {bcrypt}. Keep the single quotes: they stop compose from reading the $ signs.
#
# APP_SECURITY_USERS_0_USERNAME=admin
# APP_SECURITY_USERS_0_PASSWORD='{bcrypt}$2y$12$...'
# APP_SECURITY_USERS_0_ROLES_0=ADMIN
#
# APP_SECURITY_USERS_1_USERNAME=amina
# APP_SECURITY_USERS_1_PASSWORD='{bcrypt}$2y$12$...'
